# Variables of the front end, read at build time (docs/DEPLOYMENT.md).
# Copy this file to .env.local for local development; never commit .env.local.
# Both values are public by design: the data is protected by Row Level
# Security. Never put a secret key here: every VITE_ variable ends up in
# the public bundle.

# Project URL, Supabase dashboard > Project Settings > API: https://<ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...), Project Settings > API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=
